# Copy to .env (git-ignored) or run: npm run secrets:decrypt
ANTHROPIC_API_KEY=
# Only needed for keys that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Emails (or @domains) allowed to run license checks; nobody if empty
LICENSE_CHECKERS=
# Optional: model and effort for license checks (defaults: claude-sonnet-5-5, low)
LICENSE_MODEL=
LICENSE_EFFORT=
# Google sign-in (OAuth client ID of type "Web application")
GOOGLE_CLIENT_ID=
# Optional: who may sign in, e.g. you@gmail.com,@example.com (empty = any Google account)
ALLOWED_EMAILS=
# Optional: site address used in friend request emails, and the sender address
SITE_URL=https://cokeandcode.com/pennywhistle
MAIL_FROM=
# Optional: this account takes over tunes saved before sign-in existed (data/tunes)
LEGACY_OWNER_EMAIL=
# PORT=6060
