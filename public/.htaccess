Options -Indexes
DirectoryIndex index.html
# Never serve the private folder (code, packages, .env secrets, saved tunes)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^_private(/|$) - [F,L]
</IfModule>
<FilesMatch "^\.(env|user\.ini)">
  Require all denied
</FilesMatch>
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
# The host caches static files for 30 days by default, so phones kept running old
# code after a deploy. Make browsers revalidate the app's own code (cheap 304s).
<FilesMatch "\.(html|js|mjs|css)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header unset Expires
  </IfModule>
</FilesMatch>
